# Dashboard host (e.g. Vercel) environment variables. NAMES only — never commit values.

# Supabase Postgres. Use the pooler connection string (transaction mode, port 6543) for Vercel.
DATABASE_URL=
# Supabase project URL + anon key (public by design; the anon role has no table access — RLS on, no policies).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only: used for the private evidence bucket. Never exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=
EVIDENCE_BUCKET=evidence
# Comma-separated emails allowed to use the dashboard (Supabase Auth users).
ADMIN_EMAILS=
# Shared secret between the dashboard and the GitHub Actions runner (>= 32 random chars).
RUNNER_API_SECRET=
# GitHub repo "owner/name" and a fine-grained token with Actions: read & write on this repo only.
GITHUB_REPOSITORY_SLUG=
GITHUB_DISPATCH_TOKEN=
GITHUB_WORKFLOW_FILE=outreach-run.yml
GITHUB_WORKFLOW_REF=main
# Optional tuning
PROCESSING_BUDGET_MINUTES=300
NEW_WORK_CUTOFF_SECONDS=480

# GitHub Actions secrets (repository settings -> Secrets and variables -> Actions):
#   DASHBOARD_URL          e.g. https://your-dashboard.vercel.app
#   RUNNER_API_SECRET      same value as above
#   BRAVE_SEARCH_API_KEY   Brave Search API subscription token
